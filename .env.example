# ── LLM Provider (AgentRouter — OpenAI-compatible) ──────────────
LLM_PROVIDER=agentrouter
LLM_API_KEY=                                      # unlimited-quota token for the deployed/judged service
LLM_MODEL=claude-haiku-4-5                        # confirm exact model id string in the AgentRouter dashboard
LLM_BASE_URL=https://agentrouter.org/v1
LLM_REQUEST_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=1

# ── Optional: fallback key/model (recommended for reliability) ──
LLM_FALLBACK_API_KEY=                             # a backup token, used only if the primary fails
LLM_FALLBACK_MODEL=claude-haiku-4-5

# ── Server ────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
REQUEST_TIMEOUT_SECONDS=25                        # stay comfortably under the judge's 30s hard limit

# ── Optimizer ─────────────────────────────────────────────────
SOLVER=pulp                                       # or scipy
NUMERIC_TOLERANCE=0.01

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
