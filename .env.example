# ── LLM Provider (OpenAI-compatible) ────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=                                   # your OpenAI API key
LLM_MODEL=gpt-4o-mini                              # or another chat-completions model you want to use
LLM_BASE_URL=https://api.openai.com/v1
LLM_REQUEST_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=1

# ── Optional: fallback key/model (recommended for reliability) ──
LLM_FALLBACK_API_KEY=                             # a backup token, used only if the primary fails
LLM_FALLBACK_MODEL=gpt-4o-mini

# ── Server ────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
REQUEST_TIMEOUT_SECONDS=25                        # stay comfortably under the judge's 30s hard limit

# ── Optimizer ─────────────────────────────────────────────────
SOLVER=pulp                                       # or scipy
NUMERIC_TOLERANCE=0.01

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
